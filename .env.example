APP_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Public site host controls
CANONICAL_SCHEME=https
CANONICAL_HOST=example.com
PUBLIC_HOSTNAMES=example.com,www.example.com
ADMIN_HOSTNAME=admin.example.com
EMBED_ALLOWED_ORIGIN=https://example.com

# Backend endpoints (replace with your own)
EXG_API_URL=https://example.com/ServerList/CurrentStatus
WATCHER_SERVICE_URL=http://127.0.0.1:5010

# Agent
AGENT_MASTER_URL=https://example.com
AGENT_SHARED_TOKEN=REPLACE_WITH_AGENT_TOKEN
AGENT_CONFIG_FILE=config.json
AGENT_POLL_INTERVAL_SECONDS=15

# Steam/OpenID (set to your own provider endpoint if needed)
STEAM_COMMUNITY_BASE_URL=https://example.com
STEAM_OPENID_ENDPOINT=https://example.com/openid/login

# Optional database/session config
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=example_db
MYSQL_USER=example_user
MYSQL_PASSWORD=REPLACE_WITH_DB_PASSWORD
REDIS_URL=redis://127.0.0.1:6379/0
