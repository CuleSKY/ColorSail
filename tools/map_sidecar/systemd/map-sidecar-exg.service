[Unit]
Description=CS2ZE Map Sidecar - EXG ingest health check
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/1panel/www/sites/www.cs2ze.org/NERV_CS2ZE
EnvironmentFile=-/etc/default/map-sidecar
ExecStart=/usr/bin/python3 ${PROJECT_ROOT}/tools/map_sidecar/map_sidecar.py exg-health
