[Unit]
Description=CS2ZE Map Sidecar - Poll /servers.json and export map_translations.json
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/1panel/www/sites/www.cs2ze.org/NERV_CS2ZE
EnvironmentFile=-/etc/default/map-sidecar
ExecStart=/usr/bin/python3 -m tools.map_sidecar.main poll-servers
